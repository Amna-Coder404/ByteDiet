{
  "expo": {
    "name": "ByteDiet",
    "slug": "bytediet",
    "version": "1.0.0",
    "scheme": "bytediet",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bytediet.app"
    },
    "android": {
      "package": "com.bytediet.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#7312E0"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7312E0"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ByteDiet to use your camera to scan your food.",
          "photosPermission": "Allow ByteDiet to access your photos to analyze meals."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "411401db-f4ff-4299-8257-dbd4ad67cefb"
      }
    }
  }
}